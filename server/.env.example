# Server Port
PORT=5000

# Choose database mode: 'json', 'local_pg', 'docker_pg', or 'render_pg'
DB_MODE=json

# 1. Local PostgreSQL (installed directly on host)
DB_LOCAL_URL=postgresql://postgres:postgres@localhost:5432/exam_app

# 2. Local Docker PostgreSQL (running via docker-compose on port 5435)
DB_DOCKER_URL=postgresql://postgres:postgres@localhost:5435/exam_app

# 3. Production / Render PostgreSQL
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?ssl=true

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# ══════════════════════════════════════════════════════════
#  E-Test System — Server Environment Template
#  Copy this file: cp .env.example .env
#  Then fill in the values for your environment.
# ══════════════════════════════════════════════════════════
#
#  NOTE: When using Docker Compose (docker compose up --build),
#  you do NOT need a .env file at all — all variables are
#  injected by docker-compose.yml automatically.
#
# ══════════════════════════════════════════════════════════

# Server listen port
PORT=5000

# ─── Database Mode ───────────────────────────────────────
# Choose one: 'json' | 'local_pg' | 'docker_pg' | 'render_pg'
#
#   json       → Local JSON file (no PostgreSQL)
#   local_pg   → PostgreSQL on host machine (port 5432)
#   docker_pg  → PostgreSQL in Docker container (port 5435)
#   render_pg  → Render.com cloud PostgreSQL (production)
DB_MODE=docker_pg

# ─── Database URL ────────────────────────────────────────
# For docker_pg (local Docker):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5435/exam_app
#
# For local_pg (host PostgreSQL):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/exam_app
#
# For render_pg (production):
#   Set DATABASE_URL in the Render dashboard Environment Variables.
#   Do NOT put the real Render URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/exam_app

# ─── JWT Secret ──────────────────────────────────────────
# Used to sign and verify authentication tokens.
# Use a long random string in production.
# For production: set this in the Render dashboard, not here.
JWT_SECRET=change-me-in-production

# ─── Local PostgreSQL (if DB_MODE=local_pg) ──────────────
# DB_LOCAL_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/exam_app
